# Sanity Project Configuration
SANITY_PROJECT_ID=0ovd9f2s
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01

# Sanity API Write Token
# Generate a token with Editor or Administrator permissions at:
# https://sanity.io/manage/project/0ovd9f2s/api#tokens
# Note: If running in an environment where the Sanity CLI is already authenticated,
# the seed script will automatically fall back to the authenticated CLI session if SANITY_WRITE_TOKEN is empty.
SANITY_WRITE_TOKEN=

# Sanity Context MCP Read Token (Required at runtime for agent)
# Generate a Context token at: https://www.sanity.io/organizations/oyl832pn4/api/tokens
SANITY_API_READ_TOKEN=

# Hosted Sanity Context MCP Endpoint URL
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/oyl832pn4/mcp/devdocs-gemini-agent

# Google Gemini API Key for AI Agent (Required at runtime)
GEMINI_API_KEY=

# Server Port (Optional, defaults to 3001)
PORT=3001


