# Sanity Context MCP Read Token (Required server-side)
# Obtain from https://www.sanity.io/organizations/oyl832pn4/api/tokens
SANITY_API_READ_TOKEN=

# Hosted Sanity Context MCP Endpoint URL
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/oyl832pn4/mcp/devdocs-gemini-agent

# Google Gemini API Key (Required server-side)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model Selection (Optional, defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Sanity Project Info (Optional)
SANITY_PROJECT_ID=0ovd9f2s
SANITY_DATASET=production
